    "fake_lock.error.not_active" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start a browser session first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先启动浏览器会话。"}}}},
    "fake_lock.error.script_create" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not create the browser control script."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法创建浏览器控制脚本。"}}}},
    "fake_lock.error.script_failed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Browser control failed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"浏览器控制失败。"}}}},
    "fake_lock.fullscreen" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open in Full Screen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全屏打开"}}}},
    "fake_lock.fullscreen.subtitle" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MapTest Bypass always starts in full screen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MapTest Bypass 始终以全屏启动"}}}},
    "fake_lock.go_backward" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"后退"}}}},
    "fake_lock.go_forward" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Forward"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前进"}}}},
