    "browser.not_running_caption" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmt was passiert wenn du ein Tastenkürzel für einen Browser auslöst der momentan nicht läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
