    "browser.default_caption" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standardbrowser wird verwendet wenn du manuell einen Tab hinzufügst ohne dass ein Browser geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The default browser is used when you manually add a tab without a browser currently open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El navegador predeterminado se usa cuando añades manualmente una pestaña sin un navegador abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le navigateur par défaut est utilisé quand tu ajoutes manuellement un onglet sans navigateur ouvert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動でタブを追加する際にブラウザが開いていない場合、このデフォルトブラウザが使われる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수동으로 탭을 추가할 때 브라우저가 열려있지 않으면 이 기본 브라우저를 사용해."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O navegador padrão é usado quando você adiciona manualmente uma aba sem um navegador aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузер по умолчанию используется при ручном добавлении вкладки без открытого браузера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动添加页面且没开浏览器时，用这个默认浏览器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動添加頁面且沒開瀏覽器時，用這個默認瀏覽器。"
          }
        }
      }
    },
