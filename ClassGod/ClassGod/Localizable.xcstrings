    "fake_lock.guard.enabled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Navigation guard enabled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导航锁定已启用"}}}},
    "fake_lock.lock_backward" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lock Back"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁定后退"}}}},
