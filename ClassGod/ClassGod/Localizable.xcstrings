    "fake_lock.mode.maptest.description" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open the assigned MapTest URL in full screen with the selected local navigation guard."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全屏打开指定的 MapTest 网址，并应用所选的本地导航锁定。"}}}},
    "fake_lock.mode.safe_browser" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safe Browser"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Safe Browser"}}}},
    "fake_lock.mode.safe_browser.description" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open an assigned page with independent backward and forward controls."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开指定页面，并独立控制后退与前进方向。"}}}},
    "fake_lock.safety_note" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Controls only the browser and page you choose; third-party security controls are not modified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅控制你指定的浏览器与页面，不修改第三方安全机制。"}}}},
