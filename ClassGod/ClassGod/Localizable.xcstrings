    "fake_lock.shortcut.description" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starts the session when idle, or toggles the navigation guard while active."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未启动时开启会话，运行中切换导航锁定。"}}}},
