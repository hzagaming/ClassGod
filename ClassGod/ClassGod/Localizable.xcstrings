    "fake_lock.error.browser_missing" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected browser is not installed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未安装所选浏览器。"}}}},
