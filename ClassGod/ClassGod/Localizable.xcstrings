    "permission.type.accessibility.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allows ClassGod to identify the frontmost app, send keyboard events, and interact with windows for AssessPrepHack and browser switching."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "需要查询最前端应用、模拟按键事件以及与窗口交互，用于 AssessPrepHack 和浏览器切换。"
          }
        }
      }
    },
