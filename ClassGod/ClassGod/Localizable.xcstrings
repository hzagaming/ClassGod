    "fan.about.elevated" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On some Macs, especially Apple Silicon models, direct fan control may require elevated privileges and may be unavailable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "在某些 Mac 上，尤其是 Apple Silicon 机型，直接风扇控制可能需要提升权限，甚至可能不可用。"
          }
        }
      }
    },
    "fan.about.restricted" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If sensors show N/A, SMC access may be restricted on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "如果传感器显示 N/A，则可能是你的设备限制了 SMC 访问。"
          }
        }
      }
    },
    "fan.about.smc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fan Control reads hardware sensors through the System Management Controller (SMC)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "风扇控制通过系统管理控制器 (SMC) 读取硬件传感器。"
          }
        }
      }
    },
    "fan.access.apple_silicon_restricted" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon restricts fan access to approved system services. Authorize the fan control Helper, then rescan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon 仅允许获批的系统服务访问风扇。请授权风扇控制 Helper，然后重新扫描。"
          }
        }
      }
    },
    "fan.access.detected_no_rpm" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan hardware was detected, but no live RPM reading is available. Approve the privileged Helper, then rescan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已识别风扇硬件，但当前没有实时 RPM 读数。请批准特权 Helper，然后重新扫描。"
          }
        }
      }
    },
    "fan.access.hardware_read_only" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The approved Helper is reporting live RPM, but this hardware did not accept verified safe write controls."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已批准的 Helper 正在报告实时 RPM，但此硬件未通过安全写入验证，当前仅可读取。"
          }
        }
      }
    },
    "fan.access.helper_detected_no_rpm" : {
      "extractionState" : "stale",
